FROM composer:2 AS composer-build

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --optimize-autoloader --no-progress --ignore-platform-reqs

FROM node:22-slim AS asset-build

WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
COPY Gruntfile.js ./
# Grunt reads the sources in resources/assets and writes what the browser loads into public/assets.
COPY resources/assets ./resources/assets
RUN mkdir -p public/assets && yarn build

FROM php:8.2-apache

RUN apt-get update && apt-get install -y --no-install-recommends \
		libfreetype6-dev \
		libjpeg62-turbo-dev \
		libpng-dev \
		libxml2-dev \
		libonig-dev \
		libzip-dev \
	&& docker-php-ext-configure gd --with-freetype --with-jpeg \
	&& docker-php-ext-install -j$(nproc) \
		bcmath \
		gd \
		mbstring \
		mysqli \
		xml \
		zip \
	&& a2enmod rewrite \
	&& apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer-build /app/vendor /var/www/html/vendor

# Verify all required PHP extensions are installed
COPY --from=composer-build /usr/bin/composer /usr/local/bin/composer
COPY --from=composer-build /app/composer.json /app/composer.lock /tmp/composer-check/
RUN composer check-platform-reqs --no-dev --working-dir=/tmp/composer-check \
	&& rm -rf /tmp/composer-check /usr/local/bin/composer
COPY --from=asset-build   /app/public/assets /var/www/html/public/assets

COPY application /var/www/html/application
COPY bootstrap /var/www/html/bootstrap
COPY storage /var/www/html/storage
COPY uploads /var/www/html/uploads
COPY public/favicon.ico public/index.php public/robots.txt /var/www/html/public/
COPY htaccess /var/www/html/public/.htaccess

# The entrypoint runs "php index.php setup/cli/..." from /var/www/html. The front controller is public/index.php,
# so this file hands over to it. It is above the web root and cannot be requested.
RUN printf '%s\n' '<?php' '' "require __DIR__ . '/public/index.php';" > /var/www/html/index.php

# Only public/ is the web root. uploads/ stays above it and is mapped in for the logos; its private subfolders
# (archive, customer_files, import, temp) are refused by their own .htaccess files.
RUN sed -i '/<Directory \/var\/www\/>/,/<\/Directory>/ s/AllowOverride None/AllowOverride All/' \
	/etc/apache2/apache2.conf \
	&& sed -i 's#DocumentRoot /var/www/html#DocumentRoot /var/www/html/public\n\tAlias /uploads /var/www/html/uploads#' \
	/etc/apache2/sites-available/000-default.conf

RUN chown -R www-data:www-data /var/www/html \
	&& find /var/www/html -type d -exec chmod 755 {} \; \
	&& find /var/www/html -type f -exec chmod 644 {} \;

# Persistent user data and writable runtime directories.
# Mount a custom templates directory and point CUSTOM_TEMPLATES_FOLDER at it.
VOLUME ["/var/www/html/uploads", "/var/www/html/storage"]

EXPOSE 80

COPY resources/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]
CMD ["apache2-foreground"]
